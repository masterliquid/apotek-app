# Copy to .env and fill in. Never commit .env.
# TODO: Securely load these values from an environment variable or secrets vault. Do not hardcode.

# Postgres superuser/owner (used by the db container and for migrations)
POSTGRES_USER=apotek_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=apotek

# Restricted runtime role (no superuser, no BYPASSRLS). Created by docker/postgres-init.
APP_DB_PASSWORD=change-me-app

# Host-side URLs (pnpm dev / tests on your Mac talk to the Docker db on 127.0.0.1:5433)
DATABASE_URL=postgres://apotek_app:change-me-app@127.0.0.1:5433/apotek
DATABASE_ADMIN_URL=postgres://apotek_owner:change-me-owner@127.0.0.1:5433/apotek
TEST_DATABASE_URL=postgres://apotek_app:change-me-app@127.0.0.1:5433/apotek_test
TEST_DATABASE_ADMIN_URL=postgres://apotek_owner:change-me-owner@127.0.0.1:5433/apotek_test

# Cookies: keep false for plain http on localhost/LAN; set true behind HTTPS.
SESSION_COOKIE_SECURE=false

# First platform admin, created by `seed` only if no users exist yet.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin-password
